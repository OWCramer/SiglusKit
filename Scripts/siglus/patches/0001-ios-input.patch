+/// Shiori: a mouse button at the current pointer position (0 left, 1 right, 2 middle), for
+/// gestures such as a two-finger tap standing in for a right-click.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn siglus_ios_mouse_button(handle: *mut c_void, button: i32, down: i32) {
+    let Some(host) = (unsafe { (handle as *mut SiglusHost).as_mut() }) else {
+        return;
+    };
+    let button = match button {
+        1 => crate::runtime::input::VmMouseButton::Right,
+        2 => crate::runtime::input::VmMouseButton::Middle,
+        _ => crate::runtime::input::VmMouseButton::Left,
+    };
+    if down != 0 {
+        host.mouse_down(button);
+    } else {
+        host.mouse_up(button);
+    }
+}
+
+/// Shiori: wheel steps (positive is up, as on a PC wheel: backlog in most games).
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn siglus_ios_mouse_wheel(handle: *mut c_void, delta_y: i32) {
+    if let Some(host) = unsafe { (handle as *mut SiglusHost).as_mut() } {
+        host.mouse_wheel(delta_y);
+    }
+}
+
+/// Shiori: a key by Windows virtual-key code (0x0D Enter, 0x1B Escape, 0x11 Control, ...),
+/// for controllers and gestures.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn siglus_ios_key(handle: *mut c_void, code: i32, down: i32) {
+    let Some(host) = (unsafe { (handle as *mut SiglusHost).as_mut() }) else {
+        return;
+    };
+    if down != 0 {
+        host.key_down_code(code);
+    } else {
+        host.key_up_code(code);
+    }
+}
