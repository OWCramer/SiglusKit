new file mode 100644
index 0000000..0211bdf
--- /dev/null
+++ b/crates/shiori_host_media/src/lib.rs
@@ -0,0 +1,230 @@
+//! Shiori: movie decoding the host app provides.
+//!
+//! Upstream siglus_rs decodes Windows Media movies (ASF with WMV video and WMA sound) and
+//! MPEG-1/2 video with its own Rust ports of FFmpeg's decoders (`na_wmv_player`, and the video
+//! half of `na_mpeg2_decoder`). Shiori builds without those ports and hands the work to the
+//! app, which decodes with its own LGPL build of FFmpeg: the app registers its decoders once,
+//! with `siglus_set_host_media` (siglus.h), before it creates a game. Without them these movies
+//! don't open, and the game goes on past them.
+//!
+//! - [`wmv`]: an ASF file, read through callbacks into Rust, demuxed and decoded by the host
+//!   (WMV 7/8/9 and VC-1 pictures, WMA 1/2, Pro and Lossless sound). Same interface as the
+//!   `wmv_decoder` crate it replaces.
+//! - [`mpeg`]: an MPEG-1/2 video elementary stream, pushed in pieces as siglus_rs's own
+//!   demuxer finds them (`na_mpeg2_decoder` keeps its demuxer and MPEG audio).
+
+use std::ffi::c_void;
+use std::io::{Read, Seek, SeekFrom};
+use std::sync::Mutex;
+
+pub mod mpeg;
+pub mod wmv;
+
+/// No timestamp.
+pub const SIGLUS_HOST_NO_PTS: i64 = i64::MIN;
+
+/// One decoded picture, 8-bit planar Y'CbCr; the planes stay valid until the next call on the
+/// same handle.
+#[repr(C)]
+#[derive(Clone, Copy)]
+pub struct SiglusHostPicture {
+    pub width: u32,
+    pub height: u32,
+    /// Y, Cb, Cr.
+    pub planes: [*const u8; 3],
+    /// Bytes per row of each plane.
+    pub strides: [u32; 3],
+    /// log2 of the chroma subsampling (1, 1 for 4:2:0).
+    pub chroma_shift_x: u32,
+    pub chroma_shift_y: u32,
+    /// Milliseconds for an ASF movie, 90 kHz ticks for MPEG video; `SIGLUS_HOST_NO_PTS` when
+    /// unknown.
+    pub pts: i64,
+    pub key_frame: i32,
+}
+
+/// Decoded sound, interleaved 32-bit float; valid until the next call on the same handle.
+#[repr(C)]
+#[derive(Clone, Copy)]
+pub struct SiglusHostSound {
+    pub samples: *const f32,
+    pub frames: u32,
+    pub channels: u32,
+    pub sample_rate: u32,
+    /// Milliseconds, or `SIGLUS_HOST_NO_PTS`.
+    pub pts_ms: i64,
+}
+
+/// What an opened movie has. `has_video`/`has_audio`: 1 a stream the host decodes, 0 none,
+/// -1 a stream it can't decode.
+#[repr(C)]
+#[derive(Clone, Copy, Default)]
+pub struct SiglusHostMovieInfo {
+    pub width: u32,
+    pub height: u32,
+    /// -1 when unknown.
+    pub duration_ms: i64,
+    pub has_video: i32,
+    pub has_audio: i32,
+    pub sample_rate: u32,
+    pub channels: u32,
+}
+
+/// The movie file, read by the host through Rust: `read` returns the bytes read (0 at the end,
+/// negative on error); `seek` takes SEEK_SET, SEEK_CUR or SEEK_END (or 0x10000, AVSEEK_SIZE:
+/// the file's size) and returns the new position, negative on error.
+#[repr(C)]
+#[derive(Clone, Copy)]
+pub struct SiglusHostIO {
+    pub opaque: *mut c_void,
+    pub read: unsafe extern "C" fn(opaque: *mut c_void, buf: *mut u8, len: i32) -> i32,
+    pub seek: unsafe extern "C" fn(opaque: *mut c_void, offset: i64, whence: i32) -> i64,
+}
+
+/// The decoders the host provides (`siglus_set_host_media`). Any may be missing.
+#[repr(C)]
+#[derive(Clone, Copy)]
+pub struct SiglusHostMedia {
+    /// 1.
+    pub version: u32,
+    /// Opens an ASF file through `io` (which stays valid until `asf_close`) for its video
+    /// (`want` 1) or its sound (`want` 2), and fills `info`. NULL when it isn't a movie the
+    /// host can read.
+    pub asf_open: Option<
+        unsafe extern "C" fn(io: *const SiglusHostIO, want: i32, info: *mut SiglusHostMovieInfo) -> *mut c_void,
+    >,
+    /// The next picture in presentation order: 1, 0 at the end, negative on error.
+    pub asf_next_picture: Option<unsafe extern "C" fn(movie: *mut c_void, out: *mut SiglusHostPicture) -> i32>,
+    /// The next piece of sound: 1, 0 at the end, negative on error.
+    pub asf_next_sound: Option<unsafe extern "C" fn(movie: *mut c_void, out: *mut SiglusHostSound) -> i32>,
+    pub asf_close: Option<unsafe extern "C" fn(movie: *mut c_void)>,
+    /// An MPEG-1/2 video decoder fed elementary-stream bytes in arbitrary pieces.
+    pub mpeg_video_open: Option<unsafe extern "C" fn() -> *mut c_void>,
+    /// Feeds `len` bytes whose first picture starts at `pts_90k` (or `SIGLUS_HOST_NO_PTS`);
+    /// NULL data drains the decoder at the end of the stream. 0, or negative on a fatal error
+    /// (damaged data is skipped, not an error).
+    pub mpeg_video_send:
+        Option<unsafe extern "C" fn(decoder: *mut c_void, data: *const u8, len: usize, pts_90k: i64) -> i32>,
+    /// The next decoded picture in presentation order: 1, or 0 when it needs more data.
+    pub mpeg_video_receive: Option<unsafe extern "C" fn(decoder: *mut c_void, out: *mut SiglusHostPicture) -> i32>,
+    pub mpeg_video_close: Option<unsafe extern "C" fn(decoder: *mut c_void)>,
+}
+
+// Plain function pointers; the host's decoders may run on any thread (one call at a time per
+// handle).
+unsafe impl Send for SiglusHostMedia {}
+
+static HOST: Mutex<Option<SiglusHostMedia>> = Mutex::new(None);
+
+/// Registers the host's decoders (copied; NULL removes them). Call before creating a game.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn siglus_set_host_media(media: *const SiglusHostMedia) {
+    let media = unsafe { media.as_ref() }.copied();
+    *HOST.lock().unwrap_or_else(|e| e.into_inner()) = media;
+}
+
+pub(crate) fn host() -> anyhow::Result<SiglusHostMedia> {
+    HOST.lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .filter(|media| media.version >= 1)
+        .ok_or_else(|| anyhow::anyhow!("no movie decoder: the host never called siglus_set_host_media"))
+}
+
+pub(crate) unsafe extern "C" fn io_read<R: Read>(opaque: *mut c_void, buf: *mut u8, len: i32) -> i32 {
+    if opaque.is_null() || buf.is_null() || len <= 0 {
+        return if len == 0 { 0 } else { -1 };
+    }
+    let reader = unsafe { &mut *(opaque as *mut R) };
+    let out = unsafe { std::slice::from_raw_parts_mut(buf, len as usize) };
+    loop {
+        match reader.read(out) {
+            Ok(n) => return n as i32,
+            Err(e) if e.kind() == std::io::ErrorKind::Interrupted => continue,
+            Err(_) => return -1,
+        }
+    }
+}
+
+pub(crate) unsafe extern "C" fn io_seek<R: Seek>(opaque: *mut c_void, offset: i64, whence: i32) -> i64 {
+    if opaque.is_null() {
+        return -1;
+    }
+    let reader = unsafe { &mut *(opaque as *mut R) };
+    if whence & 0x10000 != 0 {
+        // AVSEEK_SIZE: the size, leaving the position where it was.
+        let Ok(position) = reader.stream_position() else { return -1 };
+        let size = reader.seek(SeekFrom::End(0));
+        let _ = reader.seek(SeekFrom::Start(position));
+        return size.map(|s| s as i64).unwrap_or(-1);
+    }
+    let target = match whence & 3 {
+        0 if offset >= 0 => SeekFrom::Start(offset as u64),
+        1 => SeekFrom::Current(offset),
+        2 => SeekFrom::End(offset),
+        _ => return -1,
+    };
+    reader.seek(target).map(|p| p as i64).unwrap_or(-1)
+}
+
+/// A borrowed view of a host picture.
+pub struct Picture<'a> {
+    pub width: usize,
+    pub height: usize,
+    pub chroma_shift: (u32, u32),
+    pub planes: [&'a [u8]; 3],
+    pub strides: [usize; 3],
+    pub pts: Option<i64>,
+    pub key_frame: bool,
+}
+
+impl<'a> Picture<'a> {
+    /// # Safety
+    /// The planes must hold `height` (or the subsampled height) rows of `stride` bytes.
+    pub(crate) unsafe fn from_host(p: &SiglusHostPicture) -> Option<Self> {
+        let width = p.width as usize;
+        let height = p.height as usize;
+        if width == 0 || height == 0 || p.chroma_shift_x > 2 || p.chroma_shift_y > 2 {
+            return None;
+        }
+        let ch = (height + (1 << p.chroma_shift_y) - 1) >> p.chroma_shift_y;
+        let cw = (width + (1 << p.chroma_shift_x) - 1) >> p.chroma_shift_x;
+        let rows = [height, ch, ch];
+        let widths = [width, cw, cw];
+        let mut planes: [&[u8]; 3] = [&[], &[], &[]];
+        let mut strides = [0usize; 3];
+        for i in 0..3 {
+            let stride = p.strides[i] as usize;
+            if p.planes[i].is_null() || stride < widths[i] {
+                return None;
+            }
+            let len = stride * (rows[i] - 1) + widths[i];
+            planes[i] = unsafe { std::slice::from_raw_parts(p.planes[i], len) };
+            strides[i] = stride;
+        }
+        Some(Self {
+            width,
+            height,
+            chroma_shift: (p.chroma_shift_x, p.chroma_shift_y),
+            planes,
+            strides,
+            pts: (p.pts != SIGLUS_HOST_NO_PTS).then_some(p.pts),
+            key_frame: p.key_frame != 0,
+        })
+    }
+
+    pub fn chroma_size(&self) -> (usize, usize) {
+        let (sx, sy) = self.chroma_shift;
+        ((self.width + (1 << sx) - 1) >> sx, (self.height + (1 << sy) - 1) >> sy)
+    }
+
+    /// Plane `i` copied into a tightly packed buffer.
+    pub fn packed_plane(&self, i: usize) -> Vec<u8> {
+        let (w, h) = if i == 0 { (self.width, self.height) } else { self.chroma_size() };
+        let mut out = Vec::with_capacity(w * h);
+        for row in 0..h {
+            let start = row * self.strides[i];
+            out.extend_from_slice(&self.planes[i][start..start + w]);
+        }
+        out
+    }
+}
