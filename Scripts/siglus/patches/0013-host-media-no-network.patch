@@ -0,0 +1,101 @@
+//! Shiori: MPEG-1/2 video decoded by the host app (`shiori_host_media`), in place of the
+//! decoder translated from FFmpeg that Shiori builds without. Same interface: elementary-stream
+//! bytes in, pictures in presentation order out.
+
+use std::sync::Arc;
+
+use shiori_host_media::mpeg::MpegVideoDecoder;
+
+use super::error::{DecodeError, Result};
+use super::frame::{Frame, PixelFormat};
+
+#[derive(Debug, Default)]
+pub struct Decoder {
+    host: Option<MpegVideoDecoder>,
+    failed: bool,
+}
+
+impl Decoder {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    fn host(&mut self) -> Result<&mut MpegVideoDecoder> {
+        if self.host.is_none() {
+            if self.failed {
+                return Err(DecodeError::Unsupported("no MPEG video decoder"));
+            }
+            match MpegVideoDecoder::new() {
+                Ok(decoder) => self.host = Some(decoder),
+                Err(err) => {
+                    log::error!("MPEG video: {err:#}");
+                    self.failed = true;
+                    return Err(DecodeError::Unsupported("no MPEG video decoder"));
+                }
+            }
+        }
+        Ok(self.host.as_mut().expect("opened above"))
+    }
+
+    fn collect(decoder: &mut MpegVideoDecoder, out: &mut Vec<Arc<Frame>>) -> Result<()> {
+        loop {
+            let picture = decoder.receive().map_err(|err| {
+                log::error!("MPEG video: {err:#}");
+                DecodeError::Internal("host decoder")
+            })?;
+            let Some(picture) = picture else { return Ok(()) };
+            let format = match picture.chroma_shift {
+                (1, 1) => PixelFormat::Yuv420p,
+                (1, 0) => PixelFormat::Yuv422p,
+                (0, 0) => PixelFormat::Yuv444p,
+                _ => return Err(DecodeError::Unsupported("chroma format")),
+            };
+            let (cw, _) = picture.chroma_size();
+            out.push(Arc::new(Frame {
+                width: picture.width,
+                height: picture.height,
+                format,
+                data_y: picture.packed_plane(0),
+                data_u: picture.packed_plane(1),
+                data_v: picture.packed_plane(2),
+                linesize_y: picture.width,
+                linesize_u: cw,
+                linesize_v: cw,
+                pts_90k: picture.pts,
+            }));
+        }
+    }
+
+    pub fn decode_shared(&mut self, data: &[u8], pts_90k: Option<i64>) -> Result<Vec<Arc<Frame>>> {
+        let decoder = self.host()?;
+        decoder.send(data, pts_90k).map_err(|err| {
+            log::error!("MPEG video: {err:#}");
+            DecodeError::Internal("host decoder")
+        })?;
+        let mut out = Vec::new();
+        Self::collect(decoder, &mut out)?;
+        Ok(out)
+    }
+
+    pub fn flush_shared(&mut self) -> Result<Vec<Arc<Frame>>> {
+        let mut out = Vec::new();
+        // Nothing was ever sent: nothing to drain.
+        let Some(decoder) = self.host.as_mut() else { return Ok(out) };
+        decoder.drain().map_err(|err| {
+            log::error!("MPEG video: {err:#}");
+            DecodeError::Internal("host decoder")
+        })?;
+        Self::collect(decoder, &mut out)?;
+        // The host decoder ends with the stream; a later push starts a new one.
+        self.host = None;
+        Ok(out)
+    }
+
+    pub fn decode(&mut self, data: &[u8], pts_90k: Option<i64>) -> Result<Vec<Frame>> {
+        Ok(self.decode_shared(data, pts_90k)?.into_iter().map(|f| (*f).clone()).collect())
+    }
+
+    pub fn flush(&mut self) -> Result<Vec<Frame>> {
+        Ok(self.flush_shared()?.into_iter().map(|f| (*f).clone()).collect())
+    }
+}
