index 0000000..3d9468d
--- /dev/null
+++ b/crates/shiori_host_media/src/mpeg.rs
@@ -0,0 +1,80 @@
+//! Shiori: an MPEG-1/2 video elementary stream decoded by the host.
+
+use std::ffi::c_void;
+use std::ptr::NonNull;
+
+use anyhow::{Result, anyhow, bail};
+
+use crate::{Picture, SIGLUS_HOST_NO_PTS, SiglusHostMedia, SiglusHostPicture, host};
+
+pub struct MpegVideoDecoder {
+    media: SiglusHostMedia,
+    handle: NonNull<c_void>,
+    picture: SiglusHostPicture,
+}
+
+// One thread at a time.
+unsafe impl Send for MpegVideoDecoder {}
+
+impl std::fmt::Debug for MpegVideoDecoder {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("MpegVideoDecoder").finish_non_exhaustive()
+    }
+}
+
+impl MpegVideoDecoder {
+    pub fn new() -> Result<Self> {
+        let media = host()?;
+        let (Some(open), Some(_), Some(_), Some(_)) =
+            (media.mpeg_video_open, media.mpeg_video_send, media.mpeg_video_receive, media.mpeg_video_close)
+        else {
+            bail!("the host has no MPEG video decoder");
+        };
+        let handle = NonNull::new(unsafe { open() }).ok_or_else(|| anyhow!("the host's MPEG video decoder didn't open"))?;
+        Ok(Self { media, handle, picture: unsafe { std::mem::zeroed() } })
+    }
+
+    /// Feeds elementary-stream bytes; `pts_90k` belongs to the first picture that starts in them.
+    pub fn send(&mut self, data: &[u8], pts_90k: Option<i64>) -> Result<()> {
+        if data.is_empty() {
+            return Ok(());
+        }
+        let send = self.media.mpeg_video_send.expect("checked at open");
+        let code = unsafe {
+            send(self.handle.as_ptr(), data.as_ptr(), data.len(), pts_90k.unwrap_or(SIGLUS_HOST_NO_PTS))
+        };
+        if code < 0 {
+            bail!("MPEG video decoding failed ({code})");
+        }
+        Ok(())
+    }
+
+    /// The end of the stream: the pictures still held come out of `receive`.
+    pub fn drain(&mut self) -> Result<()> {
+        let send = self.media.mpeg_video_send.expect("checked at open");
+        let code = unsafe { send(self.handle.as_ptr(), std::ptr::null(), 0, SIGLUS_HOST_NO_PTS) };
+        if code < 0 {
+            bail!("MPEG video decoding failed ({code})");
+        }
+        Ok(())
+    }
+
+    /// The next decoded picture, valid until the next call.
+    pub fn receive(&mut self) -> Result<Option<Picture<'_>>> {
+        let receive = self.media.mpeg_video_receive.expect("checked at open");
+        if unsafe { receive(self.handle.as_ptr(), &mut self.picture) } != 1 {
+            return Ok(None);
+        }
+        unsafe { Picture::from_host(&self.picture) }
+            .map(Some)
+            .ok_or_else(|| anyhow!("malformed picture from the host"))
+    }
+}
+
+impl Drop for MpegVideoDecoder {
+    fn drop(&mut self) {
+        if let Some(close) = self.media.mpeg_video_close {
+            unsafe { close(self.handle.as_ptr()) };
+        }
+    }
+}
diff --git a/crates/shiori_host_media/src/wmv.rs b/crates/shiori_host_media/src/wmv.rs
new file mode 100644
index 0000000..70c6020
--- /dev/null
+++ b/crates/shiori_host_media/src/wmv.rs
@@ -0,0 +1,295 @@
+//! Shiori: ASF movies (WMV video, WMA sound) decoded by the host, with the interface of the
+//! `wmv_decoder` crate (`na_wmv_player`) that Shiori builds without.
+
+use std::ffi::c_void;
+use std::io::{Read, Seek};
+use std::ptr::NonNull;
+
+use anyhow::{Result, anyhow, bail};
+
+use crate::{
+    Picture, SIGLUS_HOST_NO_PTS, SiglusHostIO, SiglusHostMedia, SiglusHostMovieInfo, SiglusHostPicture,
+    SiglusHostSound, host, io_read, io_seek,
+};
+
+const WANT_VIDEO: i32 = 1;
+const WANT_AUDIO: i32 = 2;
+
+/// One open movie: the host's handle, the reader it reads through and the callbacks it holds.
+struct AsfMovie<R> {
+    media: SiglusHostMedia,
+    handle: NonNull<c_void>,
+    info: SiglusHostMovieInfo,
+    _io: Box<SiglusHostIO>,
+    _reader: Box<R>,
+}
+
+// The handle and the reader are used by one thread at a time.
+unsafe impl<R: Send> Send for AsfMovie<R> {}
+
+impl<R: Read + Seek> AsfMovie<R> {
+    fn open(reader: R, want: i32) -> Result<Self> {
+        let media = host()?;
+        let (Some(open), Some(_), Some(_), Some(_)) =
+            (media.asf_open, media.asf_next_picture, media.asf_next_sound, media.asf_close)
+        else {
+            bail!("the host has no ASF movie decoder");
+        };
+        let mut reader = Box::new(reader);
+        let io = Box::new(SiglusHostIO {
+            opaque: (&mut *reader as *mut R).cast(),
+            read: io_read::<R>,
+            seek: io_seek::<R>,
+        });
+        let mut info = SiglusHostMovieInfo { duration_ms: -1, ..Default::default() };
+        let handle = unsafe { open(&*io, want, &mut info) };
+        let handle = NonNull::new(handle).ok_or_else(|| anyhow!("the host can't read this ASF movie"))?;
+        Ok(Self { media, handle, info, _io: io, _reader: reader })
+    }
+
+    fn duration_ms(&self) -> Option<u64> {
+        (self.info.duration_ms > 0).then_some(self.info.duration_ms as u64)
+    }
+}
+
+impl<R> Drop for AsfMovie<R> {
+    fn drop(&mut self) {
+        if let Some(close) = self.media.asf_close {
+            unsafe { close(self.handle.as_ptr()) };
+        }
+    }
+}
+
+#[derive(Clone, Debug)]
+pub struct VideoStreamInfo {
+    pub width: u32,
+    pub height: u32,
+}
+
+/// A 4:2:0 picture, tightly packed; the chroma planes are `(width + 1) / 2` wide.
+#[derive(Clone, Debug)]
+pub struct YuvFrame {
+    pub width: u32,
+    pub height: u32,
+    pub y: Vec<u8>,
+    pub cb: Vec<u8>,
+    pub cr: Vec<u8>,
+}
+
+impl YuvFrame {
+    fn from_picture(p: &Picture<'_>) -> Self {
+        let y = p.packed_plane(0);
+        let (cw, ch) = ((p.width + 1) / 2, (p.height + 1) / 2);
+        let (cb, cr) = if p.chroma_shift == (1, 1) {
+            (p.packed_plane(1), p.packed_plane(2))
+        } else {
+            // Not 4:2:0 (WMV never is): take the sample at each 4:2:0 position.
+            let (sx, sy) = p.chroma_shift;
+            let sample = |i: usize| {
+                let mut out = Vec::with_capacity(cw * ch);
+                for row in 0..ch {
+                    let src_row = ((row * 2) >> sy) * p.strides[i];
+                    for col in 0..cw {
+                        out.push(p.planes[i][src_row + ((col * 2) >> sx)]);
+                    }
+                }
+                out
+            };
+            (sample(1), sample(2))
+        };
+        Self { width: p.width as u32, height: p.height as u32, y, cb, cr }
+    }
+}
+
+pub struct DecodedFrame {
+    pub pts_ms: u32,
+    pub is_key_frame: bool,
+    pub frame: YuvFrame,
+}
+
+pub struct PcmFrameF32 {
+    pub pts_ms: u32,
+    pub sample_rate: u32,
+    pub channels: u16,
+    /// Interleaved samples.
+    pub samples: Vec<f32>,
+}
+
+pub struct DecodedAudioFrame {
+    pub pts_ms: u32,
+    pub frame: PcmFrameF32,
+}
+
+/// An ASF movie's video (WMV 1/2/3 or VC-1).
+pub struct AsfWmv2Decoder<R> {
+    movie: AsfMovie<R>,
+    video: VideoStreamInfo,
+    last_pts_ms: u32,
+}
+
+impl<R: Read + Seek> AsfWmv2Decoder<R> {
+    pub fn open(reader: R) -> Result<Self> {
+        let movie = AsfMovie::open(reader, WANT_VIDEO)?;
+        match movie.info.has_video {
+            1 => {}
+            0 => bail!("no video stream in this ASF file"),
+            _ => bail!("unsupported ASF video stream"),
+        }
+        let video = VideoStreamInfo { width: movie.info.width, height: movie.info.height };
+        Ok(Self { movie, video, last_pts_ms: 0 })
+    }
+
+    pub fn video_stream_info(&self) -> &VideoStreamInfo {
+        &self.video
+    }
+
+    pub fn duration_ms(&self) -> Option<u64> {
+        self.movie.duration_ms()
+    }
+
+    /// The next picture in presentation order; `None` at the end.
+    pub fn next_frame(&mut self) -> Result<Option<DecodedFrame>> {
+        let next = self.movie.media.asf_next_picture.expect("checked at open");
+        let mut out: SiglusHostPicture = unsafe { std::mem::zeroed() };
+        match unsafe { next(self.movie.handle.as_ptr(), &mut out) } {
+            1 => {}
+            0 => return Ok(None),
+            code => bail!("WMV decoding failed ({code})"),
+        }
+        let picture = unsafe { Picture::from_host(&out) }.ok_or_else(|| anyhow!("malformed picture from the host"))?;
+        let pts_ms = match picture.pts {
+            Some(pts) => pts.clamp(0, u32::MAX as i64) as u32,
+            None => self.last_pts_ms,
+        };
+        self.last_pts_ms = pts_ms;
+        Ok(Some(DecodedFrame { pts_ms, is_key_frame: picture.key_frame, frame: YuvFrame::from_picture(&picture) }))
+    }
+}
+
+/// An ASF movie's sound (WMA 1/2, Pro or Lossless).
+pub struct AsfWmaDecoder<R> {
+    movie: AsfMovie<R>,
+    next_pts_ms: Option<f64>,
+}
+
+impl<R: Read + Seek> AsfWmaDecoder<R> {
+    pub fn open(reader: R) -> Result<Self> {
+        Self::open_optional(reader)?.ok_or_else(|| anyhow!("no audio stream in this ASF file"))
+    }
+
+    /// `None` when the movie has no sound; an error when its sound can't be decoded.
+    pub fn open_optional(reader: R) -> Result<Option<Self>> {
+        let movie = AsfMovie::open(reader, WANT_AUDIO)?;
+        match movie.info.has_audio {
+            1 if movie.info.sample_rate > 0 && movie.info.channels > 0 => {}
+            0 => return Ok(None),
+            _ => bail!("unsupported ASF audio stream"),
+        }
+        Ok(Some(Self { movie, next_pts_ms: None }))
+    }
+
+    pub fn sample_rate(&self) -> u32 {
+        self.movie.info.sample_rate
+    }
+
+    pub fn channels(&self) -> u16 {
+        self.movie.info.channels.min(u16::MAX as u32) as u16
+    }
+
+    pub fn duration_ms(&self) -> Option<u64> {
+        self.movie.duration_ms()
+    }
+
+    /// The next piece of sound; `None` at the end.
+    pub fn next_frame(&mut self) -> Result<Option<DecodedAudioFrame>> {
+        let next = self.movie.media.asf_next_sound.expect("checked at open");
+        loop {
+            let mut out: SiglusHostSound = unsafe { std::mem::zeroed() };
+            match unsafe { next(self.movie.handle.as_ptr(), &mut out) } {
+                1 => {}
+                0 => return Ok(None),
+                code => bail!("WMA decoding failed ({code})"),
+            }
+            if out.frames == 0 || out.channels == 0 || out.samples.is_null() {
+                continue;
+            }
+            let count = out.frames as usize * out.channels as usize;
+            let samples = unsafe { std::slice::from_raw_parts(out.samples, count) }.to_vec();
+            // Pieces after the first of a packet may carry no time: they follow on.
+            let pts_ms = if out.pts_ms != SIGLUS_HOST_NO_PTS {
+                out.pts_ms.max(0) as f64
+            } else {
+                self.next_pts_ms.unwrap_or(0.0)
+            };
+            let rate = out.sample_rate.max(1);
+            self.next_pts_ms = Some(pts_ms + out.frames as f64 * 1000.0 / rate as f64);
+            let pts_ms = pts_ms.round().min(u32::MAX as f64) as u32;
+            return Ok(Some(DecodedAudioFrame {
+                pts_ms,
+                frame: PcmFrameF32 {
+                    pts_ms,
+                    sample_rate: out.sample_rate,
+                    channels: out.channels.min(u16::MAX as u32) as u16,
+                    samples,
+                },
+            }));
+        }
+    }
+}
+
+/// Studio-range Y'CbCr to RGB coefficients (×256): BT.601 for standard definition (576 lines
+/// or fewer) and BT.709 above, as Windows assumes for WMV, which carries no matrix.
+fn coefficients(height: u32) -> (i32, i32, i32, i32) {
+    if height > 576 { (459, 55, 136, 541) } else { (409, 100, 208, 516) }
+}
+
+/// RGBA at `output_width`×`output_height` (nearest sample when it differs from the picture).
+pub fn yuv420p_to_rgba_scaled(frame: &YuvFrame, output_width: u32, output_height: u32) -> Vec<u8> {
+    let (w, h) = (frame.width as usize, frame.height as usize);
+    let (ow, oh) = (output_width as usize, output_height as usize);
+    let mut rgba = vec![0u8; ow * oh * 4];
+    if w == 0 || h == 0 || ow == 0 || oh == 0 {
+        return rgba;
+    }
+    let cw = (w + 1) / 2;
+    let (rv, gu, gv, bu) = coefficients(frame.height);
+    let same = ow == w && oh == h;
+    for out_y in 0..oh {
+        let y = if same { out_y } else { out_y * h / oh };
+        let luma = &frame.y[y * w..y * w + w];
+        let crow = (y / 2) * cw;
+        let cb = &frame.cb[crow..crow + cw];
+        let cr = &frame.cr[crow..crow + cw];
+        let out = &mut rgba[out_y * ow * 4..(out_y + 1) * ow * 4];
+        for (out_x, px) in out.chunks_exact_mut(4).enumerate() {
+            let x = if same { out_x } else { out_x * w / ow };
+            let c = 298 * (luma[x] as i32 - 16).max(0) + 128;
+            let d = cb[x / 2] as i32 - 128;
+            let e = cr[x / 2] as i32 - 128;
+            px[0] = ((c + rv * e) >> 8).clamp(0, 255) as u8;
+            px[1] = ((c - gu * d - gv * e) >> 8).clamp(0, 255) as u8;
+            px[2] = ((c + bu * d) >> 8).clamp(0, 255) as u8;
+            px[3] = 255;
+        }
+    }
+    rgba
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn black_and_white() {
+        let frame = YuvFrame { width: 2, height: 2, y: vec![16, 235, 16, 235], cb: vec![128], cr: vec![128] };
+        let rgba = yuv420p_to_rgba_scaled(&frame, 2, 2);
+        assert_eq!(&rgba[0..4], &[0, 0, 0, 255]);
+        assert_eq!(&rgba[4..8], &[255, 255, 255, 255]);
+    }
+
+    #[test]
+    fn odd_width_has_a_chroma_column_for_the_last_pixel() {
+        let frame = YuvFrame { width: 3, height: 1, y: vec![16; 3], cb: vec![128; 2], cr: vec![128; 2] };
+        assert_eq!(yuv420p_to_rgba_scaled(&frame, 3, 1).len(), 12);
+    }
+}
