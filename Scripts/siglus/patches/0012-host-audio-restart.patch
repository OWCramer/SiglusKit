+/// Shiori: rebuilds the audio output stream on the current output (within half a second),
+/// keeping everything that plays. iOS stops the output unit on an interruption or a media
+/// services reset and never starts it again; the host calls this when the interruption ends,
+/// the route changes or media services come back. Needs no handle.
+#[unsafe(no_mangle)]
+pub extern "C" fn siglus_ios_restart_audio() {
+    kira::manager::backend::cpal::request_stream_restart();
+}
