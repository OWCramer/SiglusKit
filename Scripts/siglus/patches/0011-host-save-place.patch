+/// Shiori: saves the game's place, in its own format, as the app leaves the screen or the
+/// player leaves the game (`SceneVm::shiori_host_save`): into normal slot `index`, or the
+/// first empty slot when `index` is negative. Call between steps. Returns the
+/// slot written, -1 when the game can't save now, -2 when no slot is free, -3 on failure;
+/// with `dry_run` nonzero it only answers which.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn siglus_ios_save_place(handle: *mut c_void, index: i32, dry_run: i32) -> i32 {
+    let Some(host) = (unsafe { (handle as *mut SiglusHost).as_mut() }) else {
+        return -1;
+    };
+    host.vm_mut().shiori_host_save(index as i64, dry_run != 0) as i32
+}
