+    /// Shiori: a save the host asks for as the app leaves the screen or the player leaves
+    /// the game. It writes what the game's own SAVE writes (the save point taken where the
+    /// message on screen began, never the live state), into normal slot `index`, or the
+    /// first empty slot when `index` is negative, so the game's Load screen and
+    /// its Continue (the newest save) find it. Only between steps, and only when the game
+    /// could save itself: it has a save point (none on the title or in a scene that
+    /// cleared it), its script hasn't switched saving off, and no load, save or system
+    /// command (return to title, a confirmation) is pending. With `dry_run`, nothing is
+    /// written. Returns the slot, -1 when the game can't save now, -2 when no slot is
+    /// free, -3 when writing failed.
+    pub fn shiori_host_save(&mut self, index: i64, dry_run: bool) -> i64 {
+        let available = self
+            .ctx
+            .local_save_snapshot
+            .as_ref()
+            .is_some_and(|s| !s.local_stream.is_empty())
+            || self.ctx.has_pending_auto_savepoint();
+        if !available
+            || self.ctx.globals.syscom.save_feature.check_enabled() != 1
+            || self.ctx.globals.syscom.pending_proc.is_some()
+            || self.ctx.has_pending_runtime_save_or_load()
+        {
+            return -1;
+        }
+        let save_cnt = self.configured_runtime_save_count(false);
+        let slot = if index >= 0 && (index as usize) < save_cnt {
+            index as usize
+        } else {
+            let free = (0..save_cnt).find(|&idx| {
+                self.runtime_save_file_path(RuntimeSaveKind::Normal, idx)
+                    .is_some_and(|path| !crate::resource::game_file_exists(&path))
+            });
+            match free {
+                Some(idx) => idx,
+                None => return -2,
+            }
+        };
+        if dry_run {
+            return slot as i64;
+        }
+        if self.ctx.take_pending_auto_savepoint() {
+            // As drain_runtime_save_load_requests does at the next boundary.
+            self.build_local_save_snapshot();
+            if let Some(snapshot) = self.ctx.local_save_snapshot.as_mut() {
+                snapshot.save_msg = self.ctx.globals.syscom.current_save_message.clone();
+            }
+        }
+        // The same place already in the same slot (the app left the screen again without
+        // reading on): nothing new to write or sync.
+        let place = {
+            use std::hash::{Hash, Hasher};
+            let mut hasher = std::collections::hash_map::DefaultHasher::new();
+            if let Some(snapshot) = self.ctx.local_save_snapshot.as_ref() {
+                snapshot.local_stream.hash(&mut hasher);
+                snapshot.save_msg.hash(&mut hasher);
+            }
+            (self.ctx.project_dir.clone(), slot, hasher.finish())
+        };
+        static LAST_HOST_SAVE: std::sync::Mutex<Option<(std::path::PathBuf, usize, u64)>> =
+            std::sync::Mutex::new(None);
+        let unchanged = LAST_HOST_SAVE.lock().map(|last| last.as_ref() == Some(&place)).unwrap_or(false);
+        if unchanged
+            && self
+                .runtime_save_file_path(RuntimeSaveKind::Normal, slot)
+                .is_some_and(|path| crate::resource::game_file_exists(&path))
+        {
+            return slot as i64;
+        }
+        crate::runtime::forms::syscom::prepare_runtime_save_thumb_capture_with_priority(
+            &mut self.ctx,
+            crate::runtime::forms::syscom::CAPTURE_PRIOR_SAVE,
+        );
+        match self.perform_runtime_save_request(RuntimeSaveRequest {
+            kind: RuntimeSaveKind::Normal,
+            index: slot,
+        }) {
+            Ok(()) => {
+                if let Ok(mut last) = LAST_HOST_SAVE.lock() {
+                    *last = Some(place);
+                }
+                slot as i64
+            }
+            Err(err) => {
+                log::error!("[SG_SAVELOAD] Shiori's save to slot {slot} failed: {err:#}");
+                -3
+            }
+        }
+    }
