 const CHECK_STREAM_INTERVAL: Duration = Duration::from_millis(500);
 
+/// Counts [`request_stream_restart`] calls; each stream manager's thread restarts its stream
+/// on its next check when this has moved on (Shiori: iOS stops the output unit on an
+/// interruption or a media services reset and never starts it again, so the host asks for a
+/// new stream).
+static RESTART_GENERATION: AtomicU64 = AtomicU64::new(0);
+
+/// Asks every running stream manager to rebuild its output stream on the default device
+/// (within half a second), keeping the renderer and so everything playing.
+pub fn request_stream_restart() {
+	RESTART_GENERATION.fetch_add(1, Ordering::SeqCst);
+}
